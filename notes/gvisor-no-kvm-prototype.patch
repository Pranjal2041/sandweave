+func (nf *NFTables) saveStartTime() int64 { return nf.startTime.UnixNano() }
+
+func (nf *NFTables) loadStartTime(_ context.Context, nanos int64) {
+	nf.startTime = time.Unix(0, nanos)
+}
+
+func (nf *NFTables) afterLoad(context.Context) {
+	nf.rng = rand.RNGFrom(rand.Reader)
+}
+
+// Pause waits for the conntrack reaper to stop before state is serialized.
+func (nf *NFTables) Pause() {
+	if nf.connTrackReaper != nil {
+		nf.connTrackReaper.Stop()
+	}
+}
+
+// Resume restarts the reaper without discarding rules, counters or NAT tuples.
+func (nf *NFTables) Resume() {
+	if nf.connTrack == nil {
+		return
+	}
+	if nf.connTrackReaper == nil {
+		nf.connTrack.RestoreState(&nf.rng)
+		nf.connTrackReaper = nf.connTrack.StartReaper()
+	} else {
+		nf.connTrackReaper.Reset(time.Second)
+	}
+}
+
+// savedBytes stores opaque netlink data by value. Netlink views can overlap
+// within one packet; these are immutable values, not semantic pointer aliases.
+// +stateify savable
+type savedBytes struct {
+	Present bool
+	Data    string
+}
+
+func saveBytes(v []byte) savedBytes { return savedBytes{Present: v != nil, Data: string(v)} }
+func loadBytes(v savedBytes) []byte {
+	if !v.Present {
+		return nil
+	}
+	return []byte(v.Data)
+}

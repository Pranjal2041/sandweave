 		return int32(hostFD), containerName, nil
 	}
 	abspath := filepath.Join("/dev", relpath)
@@ -300,3 +303,16 @@ func openHostDevFile(ctx context.Context, relpath string, useDevGofer bool, open
 	}
 	return int32(hostFD), "", nil
 }
+
+// restoreDeviceBlockingMode undoes lisafs FD donation's O_NONBLOCK. NVIDIA's
+// nvidia_poll() skips poll_wait() for nonblocking files, so leaving this flag set
+// silently prevents fdnotifier from receiving GPU completion wakeups. Match the
+// direct-open path, which deliberately forwards only O_ACCMODE and O_NOFOLLOW.
+// Takes ownership of hostFD on failure.
+func restoreDeviceBlockingMode(hostFD int) error {
+	if err := unix.SetNonblock(hostFD, false); err != nil {
+		unix.Close(hostFD)
+		return err
+	}
+	return nil
+}

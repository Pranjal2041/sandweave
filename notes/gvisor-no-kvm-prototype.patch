+func TestCheckpointQueuedPacket(t *testing.T) {
+	a, b := veth.NewPair(1500, 8)
+	a.Pause()
+	pkt := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData([]byte("queued across checkpoint"))})
+	pkt.NetworkProtocolNumber = 55
+	var packets stack.PacketBufferList
+	packets.PushBack(pkt)
+	if n, err := a.WritePackets(packets); err != nil || n != 1 {
+		t.Fatalf("queue packet: n=%d err=%v", n, err)
+	}
+	pkt.DecRef()
+	original := []*veth.Endpoint{a, b}
+	var saved bytes.Buffer
+	if _, err := state.Save(context.Background(), &saved, &original); err != nil {
+		t.Fatal(err)
+	}
+	var restored []*veth.Endpoint
+	if _, err := state.Load(context.Background(), &saved, &restored); err != nil {
+		t.Fatal(err)
+	}
+	var wg sync.WaitGroup
+	sink := &testNetworkDispatcher{ch: make(chan *stack.PacketBuffer, 1), wg: &wg}
+	restored[1].Attach(sink)
+	restored[0].Resume()
+	defer restored[0].Close()
+	a.Resume()
+	defer a.Close()
+	select {
+	case got := <-sink.ch:
+		defer got.DecRef()
+		data := got.ToBuffer()
+		defer data.Release()
+		if !bytes.Equal(data.Flatten(), []byte("queued across checkpoint")) {
+			t.Fatalf("restored packet=%q", data.Flatten())
+		}
+	case <-time.After(time.Second):
+		t.Fatal("restored veth did not deliver its queued packet")
+	}
+}

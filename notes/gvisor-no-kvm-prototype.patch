 	"testing"
 
@@ -24,6 +25,40 @@ import (
 	"gvisor.dev/gvisor/pkg/sentry/devices/nvproxy/nvconf"
 )
 
+func TestRestoreDeviceBlockingMode(t *testing.T) {
+	for _, nonblocking := range []bool{false, true} {
+		file, err := os.CreateTemp(t.TempDir(), "donated-device")
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer file.Close()
+		fd := int(file.Fd())
+		if err := unix.SetNonblock(fd, nonblocking); err != nil {
+			t.Fatal(err)
+		}
+		before, err := unix.FcntlInt(uintptr(fd), unix.F_GETFL, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := restoreDeviceBlockingMode(fd); err != nil {
+			t.Fatal(err)
+		}
+		after, err := unix.FcntlInt(uintptr(fd), unix.F_GETFL, 0)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if want := before &^ unix.O_NONBLOCK; after != want {
+			t.Errorf("flags after donation repair = %#x, want %#x", after, want)
+		}
+		if _, err := file.Write([]byte("still writable")); err != nil {
+			t.Fatalf("repair invalidated descriptor: %v", err)
+		}
+	}
+	if err := restoreDeviceBlockingMode(-1); err != unix.EBADF {
+		t.Errorf("invalid descriptor: got %v, want EBADF", err)
+	}
+}

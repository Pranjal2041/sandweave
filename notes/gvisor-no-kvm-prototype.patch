+package sandbox
+
+import (
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+
+	"golang.org/x/sys/unix"
+	"gvisor.dev/gvisor/pkg/urpc"
+	"gvisor.dev/gvisor/runsc/boot"
+	"gvisor.dev/gvisor/runsc/config"
+)
+
+// socketNetworkConfig describes a single IPv4 Ethernet link. The peer carries
+// complete Ethernet frames, one frame per SOCK_SEQPACKET message, without a
+// virtio header or segmentation/checksum offload. The peer owns host transport.
+type socketNetworkConfig struct {
+	Socket  string `json:"socket"`
+	Address string `json:"address"`
+	Gateway string `json:"gateway"`
+	MAC     string `json:"mac"`
+	MTU     int    `json:"mtu"`
+}
+
+func socketNetworkArgs(r io.Reader, conf *config.Config, isRestore bool) (boot.CreateLinksAndRoutesArgs, string, error) {
+	var cfg socketNetworkConfig
+	dec := json.NewDecoder(r)
+	dec.DisallowUnknownFields()
+	if err := dec.Decode(&cfg); err != nil {
+		return boot.CreateLinksAndRoutesArgs{}, "", fmt.Errorf("decoding socket network configuration: %w", err)
+	}
+	if err := dec.Decode(new(any)); err != io.EOF {
+		return boot.CreateLinksAndRoutesArgs{}, "", fmt.Errorf("expected exactly one socket network configuration")
+	}
+	if !filepath.IsAbs(cfg.Socket) {
+		return boot.CreateLinksAndRoutesArgs{}, "", fmt.Errorf("network socket path must be absolute")
+	}
+	ip, subnet, err := net.ParseCIDR(cfg.Address)
+	if err != nil || ip.To4() == nil {
+		return boot.CreateLinksAndRoutesArgs{}, "", fmt.Errorf("network socket address must be an IPv4 CIDR")
+	}
+	gw := net.ParseIP(cfg.Gateway)
+	if gw.To4() == nil || !subnet.Contains(gw) || gw.Equal(ip) {
+		return boot.CreateLinksAndRoutesArgs{}, "", fmt.Errorf("network socket gateway must be a distinct IPv4 address in the guest subnet")
+	}
+	mac, err := net.ParseMAC(cfg.MAC)
+	if err != nil || len(mac) != 6 || mac[0]&1 != 0 {
+		return boot.CreateLinksAndRoutesArgs{}, "", fmt.Errorf("network socket MAC must be a unicast Ethernet address")
+	}
+	if cfg.MTU < 576 || cfg.MTU > 9000 {
+		return boot.CreateLinksAndRoutesArgs{}, "", fmt.Errorf("network socket MTU must be between 576 and 9000")
+	}
+	prefix, _ := subnet.Mask.Size()
+	args := boot.CreateLinksAndRoutesArgs{
+		LoopbackLinks: []boot.LoopbackLink{boot.DefaultLoopbackLink},
+		FDBasedLinks: []boot.FDBasedLink{{
+			Name: "eth0", MTU: cfg.MTU, LinkAddress: mac,
+			Addresses:   []boot.IPWithPrefix{{Address: ip.To4(), PrefixLen: prefix}},
+			Routes:      []boot.Route{{Destination: *subnet}},
+			NumChannels: 1, IsPacket: []bool{false}, PreConfigured: true,
+			ProcessorsPerChannel: conf.NetworkProcessorsPerChannel,
+			QDisc:                conf.QDisc, TBFRate: conf.TBFRate, TBFBurst: uint32(conf.TBFBurst),
+		}},
+		Defaultv4Gateway: boot.DefaultRoute{
+			Name: "eth0", Route: boot.Route{
+				Destination: net.IPNet{IP: net.IPv4zero.To4(), Mask: net.CIDRMask(0, 32)},
+				Gateway:     gw.To4(),
+			},
+		},
+		LogPackets:              conf.LogPackets,
+		PauseExternalNetworking: conf.PauseExternalNetworking,
+		AllowConnectedOnSave:    conf.AllowConnectedOnSave,
+		IsRestore:               isRestore,
+	}
+	return args, cfg.Socket, nil
+}
+
+func createSocketNetwork(conn *urpc.Client, conf *config.Config, isRestore bool) error {
+	f, err := os.Open(conf.NetworkSocketConfig)
+	if err != nil {
+		return fmt.Errorf("opening socket network configuration: %w", err)
+	}
+	defer f.Close()
+	args, socketPath, err := socketNetworkArgs(f, conf, isRestore)
+	if err != nil {
+		return err
+	}
+	fd, err := unix.Socket(unix.AF_UNIX, unix.SOCK_SEQPACKET|unix.SOCK_CLOEXEC, 0)
+	if err != nil {
+		return fmt.Errorf("creating network socket: %w", err)
+	}
+	linkFile := os.NewFile(uintptr(fd), "ethernet-socket")
+	defer linkFile.Close()
+	if err := unix.Connect(fd, &unix.SockaddrUnix{Name: socketPath}); err != nil {
+		return fmt.Errorf("connecting network socket %q: %w", socketPath, err)
+	}
+	args.FilePayload.Files = []*os.File{linkFile}
+	if err := conn.Call(boot.ContMgrSetNetworkArgs, &args, nil); err != nil {
+		return fmt.Errorf("creating socket network: %w", err)
+	}
+	return nil
+}

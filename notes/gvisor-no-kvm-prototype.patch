+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package erofs
+
+import (
+	"bytes"
+	"encoding/binary"
+
+	"gvisor.dev/gvisor/pkg/errors/linuxerr"
+)
+
+// Xattrs returns the inode's inline and shared extended attributes. Returned
+// strings own their storage and do not alias the mapped image. Long prefixes
+// require an incompatible feature that OpenImage does not accept.
+func (ino *Inode) Xattrs() (map[string]string, error) {
+	if ino.xattrSize == 0 {
+		return nil, nil
+	}
+	if ino.xattrSize == 12 {
+		// A header with no entries is undefined in the Linux on-disk format.
+		return nil, linuxerr.EOPNOTSUPP
+	}
+	body, err := ino.image.BytesAt(ino.xattrOff, uint64(ino.xattrSize))
+	if err != nil || len(body) < 12 {
+		return nil, linuxerr.EUCLEAN
+	}
+	sharedCount := int(body[4])
+	inlineStart := 12 + sharedCount*4
+	if inlineStart > len(body) {
+		return nil, linuxerr.EUCLEAN
+	}
+	xattrs := make(map[string]string)
+	add := func(entry []byte) (int, error) {
+		if len(entry) < 4 {
+			return 0, linuxerr.EUCLEAN
+		}
+		nameLen := int(entry[0])
+		valueLen := int(binary.LittleEndian.Uint16(entry[2:4]))
+		length := (4 + nameLen + valueLen + 3) &^ 3
+		if length > len(entry) {
+			return 0, linuxerr.EUCLEAN
+		}
+		var prefix string
+		switch entry[1] {
+		case 1:
+			prefix = "user."
+		case 2:
+			prefix = "system.posix_acl_access"
+		case 3:
+			prefix = "system.posix_acl_default"
+		case 4:
+			prefix = "trusted."
+		case 6:
+			prefix = "security."
+		default:
+			if entry[1]&0x80 != 0 {
+				return 0, linuxerr.EOPNOTSUPP
+			}
+			// Linux ignores unknown namespace indices.
+			return length, nil
+		}
+		suffix := entry[4 : 4+nameLen]
+		if bytes.IndexByte(suffix, 0) >= 0 || len(prefix)+nameLen > 255 {
+			return 0, linuxerr.EUCLEAN
+		}
+		name := prefix + string(suffix)
+		// Inline entries take precedence over shared entries, as in Linux.
+		if _, exists := xattrs[name]; !exists {
+			xattrs[name] = string(entry[4+nameLen : 4+nameLen+valueLen])
+		}
+		return length, nil
+	}
+	for entries := body[inlineStart:]; len(entries) != 0; {
+		n, err := add(entries)
+		if err != nil {
+			return nil, err
+		}
+		entries = entries[n:]
+	}
+	sharedBase := ino.image.sb.BlockAddrToOffset(ino.image.sb.XattrBlockAddr)
+	for index := 0; index < sharedCount; index++ {
+		id := binary.LittleEndian.Uint32(body[12+index*4:])
+		off := sharedBase + uint64(id)*4
+		header, err := ino.image.BytesAt(off, 4)
+		if err != nil {
+			return nil, linuxerr.EUCLEAN
+		}
+		length := (4 + uint64(header[0]) + uint64(binary.LittleEndian.Uint16(header[2:4])) + 3) &^ 3
+		entry, err := ino.image.BytesAt(off, length)
+		if err != nil {
+			return nil, linuxerr.EUCLEAN
+		}
+		if _, err := add(entry); err != nil {
+			return nil, err
+		}
+	}
+	return xattrs, nil
+}
diff --git a/pkg/erofs/xattr_test.go b/pkg/erofs/xattr_test.go
new file mode 100644
index 0000000..ced89f3
--- /dev/null
+++ b/pkg/erofs/xattr_test.go
@@ -0,0 +1,123 @@
+// Copyright 2026 The gVisor Authors.

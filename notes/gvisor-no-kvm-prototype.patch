+func TestSaveRestoreNFTables(t *testing.T) {
+	clock := tcpip.NewStdClock()
+	st := stack.New(stack.Options{Clock: clock})
+	nf := NewNFTables(st, clock, rand.RNGFrom(rand.Reader))
+	st.SetNFTables(nf)
+	table, err := nf.AddTable(stack.IP, "saved", false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	chain, err := nf.AddChainToTable(table, "output", NewBaseChainInfo(BaseChainTypeFilter, stack.NFOutput, NewIntPriority(0), "", false), "checkpoint", false, 0, nil, linux.NF_ACCEPT)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Views from a single received netlink packet overlap. Saving them must
+	// retain their bytes without asking stateify to reconstruct packet aliases.
+	packet := make([]byte, 372)
+	copy(packet[40:], []byte("snapshot metadata"))
+	table.userData = packet[40:57]
+	chain.userData = packet[43:55]
+	rule := &Rule{udata: packet[40:52]}
+	rule.addOperation(newCounter(12345, 17))
+	rule.addOperation(mustCreateImmediate(t, linux.NFT_REG_VERDICT, nil, Verdict{Code: VC(linux.NF_DROP)}))
+	if err := chain.RegisterRule(rule, -1); err != nil {
+		t.Fatal(err)
+	}
+	nf.InitConnTrackOnce()
+	nf.Pause()
+	var buf bytes.Buffer
+	if _, err := state.Save(context.Background(), &buf, &st); err != nil {
+		t.Fatal(err)
+	}
+	var restored *stack.Stack
+	if _, err := state.Load(context.Background(), &buf, &restored); err != nil {
+		t.Fatal(err)
+	}
+	rnf := restored.NFTables().(*NFTables)
+	rnf.Resume()
+	defer rnf.Pause()
+	if rnf.stack != restored || rnf.connTrack == nf.connTrack || rnf.connTrack == nil {
+		t.Fatal("restored stack or conntrack references are incorrect")
+	}
+	rchain := rnf.filters[stack.IP].tables["saved"].chains["output"]
+	if rchain.table.afFilter.nftState != rnf {
+		t.Fatal("ruleset back-reference was lost")
+	}
+	if !bytes.Equal(rchain.table.userData, packet[40:57]) || !bytes.Equal(rchain.userData, packet[43:55]) || !bytes.Equal(rchain.rules[0].udata, packet[40:52]) {
+		t.Fatal("overlapping netlink metadata was not retained")
+	}
+	savedCounter := rchain.rules[0].ops[0].(*counter)
+	if savedCounter.bytes.Load() != 12345 || savedCounter.packets.Load() != 17 {
+		t.Fatal("rule counters lost")
+	}
+	pkt := makeArbitraryIPv4Packet()
+	defer pkt.DecRef()
+	verdict, evalErr := rnf.EvaluateHook(stack.IP, stack.NFOutput, pkt, nil)
+	if evalErr != nil || verdict.Code != VC(linux.NF_DROP) {
+		t.Fatalf("restored DROP rule: verdict=%v, err=%v", verdict, evalErr)
+	}
+	if savedCounter.packets.Load() != 18 {
+		t.Fatal("restored rule counter did not advance")
+	}
+	if rule.ops[0].(*counter).packets.Load() != 17 {
+		t.Fatal("restore modified the original ruleset")
+	}
+}
+
+func TestSaveRestoreInterfaceAddressesAndRoutes(t *testing.T) {
+	st := stack.New(stack.Options{Clock: tcpip.NewStdClock(), NetworkProtocols: []stack.NetworkProtocolFactory{ipv4.NewProtocol}})
+	defer st.Destroy()
+	if err := st.CreateNIC(1, ethernet.New(loopback.New())); err != nil {
+		t.Fatal(err)
+	}
+	address := tcpip.ProtocolAddress{Protocol: ipv4.ProtocolNumber, AddressWithPrefix: tcpip.AddressWithPrefix{Address: tcpip.AddrFrom4([4]byte{127, 0, 0, 9}), PrefixLen: 8}}
+	if err := st.AddProtocolAddress(1, address, stack.AddressProperties{}); err != nil {
+		t.Fatal(err)
+	}
+	st.SetRouteTable([]tcpip.Route{{Destination: header.IPv4EmptySubnet, NIC: 1}})
+	st.Pause()
+	defer st.Resume()
+	var saved bytes.Buffer
+	if _, err := state.Save(context.Background(), &saved, &st); err != nil {
+		t.Fatal(err)
+	}
+	var restored *stack.Stack
+	if _, err := state.Load(context.Background(), &saved, &restored); err != nil {
+		t.Fatal(err)
+	}
+	restored.Restore()
+	defer restored.Destroy()
+	info, ok := restored.SingleNICInfo(1)
+	if !ok || len(info.ProtocolAddresses) != 1 || info.ProtocolAddresses[0] != address {
+		t.Fatalf("restored interface addresses: %+v", info)
+	}
+	routes := restored.GetRouteTable()
+	if len(routes) != 1 || routes[0].Destination != header.IPv4EmptySubnet || routes[0].NIC != 1 {
+		t.Fatalf("restored routes: %+v", routes)
+	}
+	// Rebinding the boot transport must retain the saved loopback configuration.
+	restored.ResetConfig()
+	if err := restored.CreateNICWithOptions(1, ethernet.New(loopback.New()), stack.NICOptions{}); err != nil {
+		t.Fatal(err)
+	}
+	restored.SetRouteTable(nil)
+	restored.Restore()
+	info, _ = restored.SingleNICInfo(1)
+	if len(info.ProtocolAddresses) != 1 || len(restored.GetRouteTable()) != 1 {
+		t.Fatal("boot network rebinding lost saved configuration")
+	}
+}

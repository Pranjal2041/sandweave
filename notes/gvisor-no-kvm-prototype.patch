+func limitedMemoryFile(t *testing.T, pages uint64) *MemoryFile {
+	t.Helper()
+	file, err := os.CreateTemp(t.TempDir(), "memory")
+	if err != nil {
+		t.Fatal(err)
+	}
+	f, err := NewMemoryFile(file, MemoryFileOpts{LimitBytes: pages * hostarch.PageSize})
+	if err != nil {
+		file.Close()
+		t.Fatal(err)
+	}
+	t.Cleanup(f.Destroy)
+	return f
+}
+
+func TestMemoryLimitConcurrentAndRestore(t *testing.T) {
+	f := limitedMemoryFile(t, 16)
+	var successes atomic.Uint32
+	var ranges [64]memmap.FileRange
+	var wg sync.WaitGroup
+	for i := range ranges {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			fr, err := f.Allocate(hostarch.PageSize, AllocOpts{})
+			if err == nil {
+				ranges[i] = fr
+				successes.Add(1)
+			}
+		}(i)
+	}
+	wg.Wait()
+	if got := successes.Load(); got != 16 {
+		t.Fatalf("successful concurrent allocations = %d, want 16", got)
+	}
+	f.mu.Lock()
+	metadata := f.exportMetadataProto()
+	f.mu.Unlock()
+	// Metadata import precedes file mapping in LoadFrom. Use metadata-only
+	// objects here so Destroy cannot unmap not-yet-created chunk mappings.
+	restored := &MemoryFile{opts: MemoryFileOpts{LimitBytes: 16 * hostarch.PageSize}}
+	restored.initFields()
+	if err := restored.importMetadataProto(metadata); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := restored.Allocate(hostarch.PageSize, AllocOpts{}); err == nil {
+		t.Fatal("restored pages escaped the budget")
+	}
+	tooSmall := &MemoryFile{opts: MemoryFileOpts{LimitBytes: 15 * hostarch.PageSize}}
+	tooSmall.initFields()
+	if err := tooSmall.importMetadataProto(metadata); err == nil {
+		t.Fatal("restore accepted a checkpoint above its configured limit")
+	}
+	for _, r := range ranges {
+		if r.Length() != 0 {
+			f.DecRef(r)
+		}
+	}
+}
+
+func TestMemoryLimitReferenceAndReclaim(t *testing.T) {
+	f := limitedMemoryFile(t, 1)
+	fr, err := f.Allocate(hostarch.PageSize, AllocOpts{})
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.IncRef(fr, 0)
+	f.DecRef(fr)
+	if _, err := f.Allocate(hostarch.PageSize, AllocOpts{}); err == nil {
+		t.Fatal("dropping one reference freed a shared page's charge")
+	}
+	// Control the releaser to verify that allocation reclaims waste itself.
+	f.mu.Lock()
+	f.unfreeSmall.MutateFullRange(fr, func(seg unfreeIterator) bool { seg.ValuePtr().refs = 0; return true })
+	f.unwasteSmall.RemoveFullRange(fr)
+	f.memAcct.MutateFullRange(fr, func(seg memAcctIterator) bool { seg.ValuePtr().wasteOrReleasing = true; return true })
+	f.mu.Unlock()
+	replacement, err := f.Allocate(hostarch.PageSize, AllocOpts{})
+	if err != nil {
+		t.Fatalf("reallocation after freeing memory: %v", err)
+	}
+	f.DecRef(replacement)
+}

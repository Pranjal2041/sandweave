--- a/src/xrt/compositor/main/comp_mirror_to_debug_gui.c
+++ b/src/xrt/compositor/main/comp_mirror_to_debug_gui.c
@@ -18,6 +18,130 @@
 
 #include "render/render_interface.h"
 
+#include "util/u_debug.h"
+#include <stdio.h>
+#include <unistd.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* On-demand evidence capture using the existing GPU readback path. No capture
+ * work is added to ordinary frames unless the request file exists. */
+DEBUG_GET_ONCE_OPTION(lab_eye_capture, "XRT_LAB_EYE_CAPTURE", NULL)
+
+static bool
+lab_file_capture_requested(void)
+{
+	const char *path = debug_get_option_lab_eye_capture();
+	char request[4096];
+	if (path == NULL || snprintf(request, sizeof(request), "%s.request", path) >= sizeof(request)) {
+		return false;
+	}
+	return access(request, F_OK) == 0;
+}
+
+static void
+lab_capture_frame(struct xrt_frame *frame)
+{
+	if (!lab_file_capture_requested()) {
+		return;
+	}
+	const char *path = debug_get_option_lab_eye_capture();
+	char temporary[4096], request[4096];
+	if (snprintf(temporary, sizeof(temporary), "%s.tmp", path) >= sizeof(temporary) ||
+	    snprintf(request, sizeof(request), "%s.request", path) >= sizeof(request)) {
+		return;
+	}
+	FILE *file = fopen(temporary, "wb");
+	if (file == NULL) {
+		return;
+	}
+	bool ok = fprintf(file, "P6\n%u %u\n255\n", frame->width, frame->height) > 0;
+	for (uint32_t y = 0; ok && y < frame->height; y++) {
+		const uint8_t *row = frame->data + y * frame->stride;
+		for (uint32_t x = 0; ok && x < frame->width; x++) {
+			ok = fwrite(row + x * 4, 3, 1, file) == 1;
+		}
+	}
+	ok = fclose(file) == 0 && ok;
+	if (ok && rename(temporary, path) == 0) {
+		unlink(request);
+	}
+}
+
+/* Ring v1 is little-endian x86_64, RGBA8, 256-byte header, 64-byte slot
+ * metadata. Aligned sequence words publish complete frames with a seqlock.
+ * A slow reader skips frames; neither model nor disk I/O blocks this writer. */
+static bool
+lab_ring_init(struct comp_mirror_to_debug_gui *m)
+{
+	const char *option = getenv("XRT_LAB_STREAM_FD");
+	if (option == NULL) {
+		return true;
+	}
+	char *end = NULL;
+	long fd = strtol(option, &end, 10);
+	struct stat st;
+	if (*end || fd < 3 || fd > 1024 || fstat((int)fd, &st) || st.st_size < 256) {
+		return false;
+	}
+	void *map = mmap(NULL, st.st_size, PROT_READ | PROT_WRITE, MAP_SHARED, (int)fd, 0);
+	if (map == MAP_FAILED) {
+		return false;
+	}
+	uint32_t *config = (uint32_t *)((uint8_t *)map + 8);
+	uint32_t width = config[1], height = config[2], slots = config[3], slot_bytes = config[4];
+	uint64_t expected = 256ull + slots * (uint64_t)slot_bytes;
+	if (memcmp(map, "VRRING1\0", 8) || config[0] != 1 || config[5] != 256 ||
+	    width < 16 || width > 4096 || height < 16 || height > 4096 ||
+	    slots < 2 || slots > 64 || slot_bytes != 64ull + width * (uint64_t)height * 4 ||
+	    slot_bytes % 64 || expected != (uint64_t)st.st_size) {
+		munmap(map, st.st_size);
+		return false;
+	}
+	m->lab_ring = map;
+	m->lab_ring_size = st.st_size;
+	m->lab_slots = slots;
+	m->lab_slot_bytes = slot_bytes;
+	m->lab_period_ns = ((uint64_t *)map)[5];
+	m->image_extent = (VkExtent2D){width, height};
+	return true;
+}
+
+bool
+comp_mirror_lab_capture_requested(struct comp_mirror_to_debug_gui *m)
+{
+	bool stream = m->lab_ring != NULL &&
+	              __atomic_load_n(&((uint64_t *)m->lab_ring)[6], __ATOMIC_ACQUIRE) != 0;
+	return (stream && (uint64_t)os_monotonic_get_ns() >= m->lab_next_ns) ||
+	       lab_file_capture_requested();
+}
+
+static void
+lab_publish_frame(struct comp_mirror_to_debug_gui *m, struct xrt_frame *frame, uint64_t ready_ns)
+{
+	if (m->lab_ring == NULL || !__atomic_load_n(&((uint64_t *)m->lab_ring)[6], __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	uint64_t seq = ++m->lab_sequence;
+	uint64_t *slot = (uint64_t *)((uint8_t *)m->lab_ring + 256 +
+	                            ((seq - 1) % m->lab_slots) * m->lab_slot_bytes);
+	__atomic_store_n(&slot[0], seq * 2 + 1, __ATOMIC_SEQ_CST);
+	slot[1] = seq;
+	slot[2] = frame->source_sequence;
+	slot[3] = frame->timestamp;
+	slot[4] = m->lab_begin_ns;
+	slot[5] = ready_ns;
+	uint8_t *pixels = (uint8_t *)slot + 64;
+	for (uint32_t y = 0; y < frame->height; y++) {
+		memcpy(pixels + y * frame->width * 4, frame->data + y * frame->stride, frame->width * 4);
+	}
+	slot[6] = os_monotonic_get_ns();
+	__atomic_store_n(&slot[0], seq * 2, __ATOMIC_RELEASE);
+	__atomic_store_n(&((uint64_t *)m->lab_ring)[4], seq, __ATOMIC_RELEASE);
+}
+
 
 /*
  *
@@ -292,6 +416,10 @@ comp_mirror_init(struct comp_mirror_to_debug_gui *m,
 		m->image_extent.width += 1;
 	}
 
+	if (!lab_ring_init(m)) {
+		return VK_ERROR_INITIALIZATION_FAILED;
+	}
+
 	vk_image_readback_to_xf_pool_create( //
 	    vk,                              // vk_bundle

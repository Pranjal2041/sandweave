+// RestoreState replaces host RNG state and rehashes saved tuples with a fresh
+// seed. Call only while packet processing and reaping are stopped.
+func (ct *ConnTrack) RestoreState(rng connTrackRNG) {
+	ct.rng = rng
+	ct.seed = rng.Uint32()
+	old := ct.buckets
+	ct.buckets = make([]bucket, len(old))
+	for i := range old {
+		for t := old[i].tuples.Front(); t != nil; t = old[i].tuples.Front() {
+			old[i].tuples.Remove(t)
+			ct.buckets[ct.bucket(t.tupleID)].tuples.PushBack(t)
+			if t.conn.finalizeResult.Load() != 0 {
+				t.conn.finalizeOnce.Do(func() {})
+			}
+		}
+	}
+}
+
+// connTrackReaper coordinates Stop with the callback, unlike a bare Timer.
+type connTrackReaper struct {
+	mu       sync.Mutex
+	timer    tcpip.Timer
+	ct       *ConnTrack
+	bucket   int
+	interval time.Duration
+	stopped  bool
+}
+
+// StartReaper starts a timer whose Stop waits for any current reaping to finish.
+func (ct *ConnTrack) StartReaper() tcpip.Timer {
+	r := &connTrackReaper{ct: ct, interval: time.Second}
+	r.mu.Lock()
+	r.timer = ct.clock.AfterFunc(r.interval, r.tick)
+	r.mu.Unlock()
+	return r
+}
+
+func (r *connTrackReaper) tick() {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.stopped {
+		return
+	}
+	r.bucket, r.interval = r.ct.reapUnused(r.bucket, r.interval)
+	r.timer.Reset(r.interval)
+}
+
+func (r *connTrackReaper) Stop() bool {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.stopped = true
+	return r.timer.Stop()
+}
+
+func (r *connTrackReaper) Reset(interval time.Duration) {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	r.stopped = false
+	r.timer.Reset(interval)
 }
 

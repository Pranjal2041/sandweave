+// dumpStalledSyscall is temporary instrumentation for the nested-host lab.
+func (t *syscallThread) dumpStalledSyscall() {
+	t.thread.Warningf("NESTED_SYSCALL_STALL sysno=%d args=%#v state=%d ret=%#x sentry=%#x stub=%#x stubStart=%#x",
+		t.sentryMessage.sysno, t.sentryMessage.args, atomic.LoadUint32(&t.sentryMessage.state),
+		t.stubMessage.ret, t.sentryAddr, t.stubAddr, stubStart)
+	runtime.LockOSThread()
+	defer runtime.UnlockOSThread()
+	if err := t.thread.attach(); err != nil {
+		t.thread.Warningf("NESTED_SYSCALL_STALL attach: %v", err)
+		return
+	}
+	t.thread.dumpRegs("NESTED_SYSCALL_STALL registers")
+	t.thread.detach()
+	if errno := hostsyscall.RawSyscallErrno(unix.SYS_TGKILL, uintptr(t.thread.tgid), uintptr(t.thread.tid), uintptr(unix.SIGCONT)); errno != 0 {
+		panic(fmt.Sprintf("diagnostic detach failed: %v", errno))
+	}
+}

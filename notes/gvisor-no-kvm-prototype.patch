+
+// +stateify savable
+type savedBacklog struct {
+	Capacity int
+	Packets  []vethPacket
+}
+
+func (v *veth) saveBacklogQueue() savedBacklog {
+	v.mu.Lock()
+	defer v.mu.Unlock()
+	saved := savedBacklog{Capacity: cap(v.backlogQueue)}
+	for count := len(v.backlogQueue); count > 0; count-- {
+		saved.Packets = append(saved.Packets, <-v.backlogQueue)
+	}
+	for _, p := range saved.Packets {
+		v.backlogQueue <- p
+	}
+	return saved
+}
+func (v *veth) loadBacklogQueue(_ context.Context, saved savedBacklog) {
+	// Slice elements may still await pointer fixups. Defer copying values
+	// into the channel until Resume, after the whole graph has loaded.
+	v.backlogQueue = make(chan vethPacket, saved.Capacity)
+	v.loadedBacklog = &saved
+}
+
+// Pause waits for the shared link's packet delivery worker to stop.
+func (e *Endpoint) Pause() {
+	v := e.veth
+	v.workerMu.Lock()
+	defer v.workerMu.Unlock()
+	if v.workerStop != nil {
+		close(v.workerStop)
+		<-v.workerDone
+		v.workerStop = nil
+	}
+}
+
+// Resume restarts packet delivery after all saved dependencies are loaded.
+func (e *Endpoint) Resume() {
+	v := e.veth
+	v.workerMu.Lock()
+	defer v.workerMu.Unlock()
+	if v.workerStop != nil {
+		return
+	}
+	if v.loadedBacklog != nil {
+		for _, p := range v.loadedBacklog.Packets {
+			v.backlogQueue <- p
+		}
+		if v.closed {
+			close(v.backlogQueue)
+		}
+		v.loadedBacklog = nil
+	}
+	v.workerStop = make(chan struct{})
+	v.workerDone = make(chan struct{})
+	stop, done := v.workerStop, v.workerDone
+	go func() {
+		defer close(done)
+		for {
+			select {
+			case <-stop:
+				return
+			case p, ok := <-v.backlogQueue:
+				if !ok {
+					return
+				}
+				p.e.InjectInbound(p.protocol, p.pkt)
+				p.pkt.DecRef()
+			}
+		}
+	}()
+}

+/**
+ * conf_tcp_port_report() - Publish ports already owned by this helper
+ * @c:    Execution context
+ * @path: Private output path, must not already exist
+ *
+ * Called before creating the UNIX listener. Its existence is the launcher's
+ * barrier: every reported TCP socket is listening and this file is closed.
+ */
+static void conf_tcp_port_report(const struct ctx *c, const char *path)
+{
+	const struct fwd_ports *fwd = &c->tcp.fwd_in;
+	const char *separator = "";
+	unsigned int port;
+	FILE *output;
+	int fd;
+
+	fd = open(path, O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+	if (fd < 0)
+		die_perror("Couldn't create TCP port report");
+	output = fdopen(fd, "w");
+	if (!output)
+		die_perror("Couldn't open TCP port report");
+	if (fputs("{", output) == EOF)
+		die_perror("Couldn't write TCP port report");
+	for (port = 1; port < NUM_PORTS; port++) {
+		if (!bitmap_isset(fwd->map, port))
+			continue;
+		if (fprintf(output, "%s\"%u\":%u", separator,
+		            (uint16_t)(port + fwd->delta[port]), port) < 0)
+			die_perror("Couldn't write TCP port report");
+		separator = ",";
+	}
+	if (fputs("}\n", output) == EOF || fclose(output))
+		die_perror("Couldn't finish TCP port report");
 }
 

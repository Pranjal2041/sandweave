+import (
+	"encoding/json"
+	"strings"
+	"testing"
+
+	"gvisor.dev/gvisor/runsc/config"
+)
+
+func TestSocketNetworkConfiguration(t *testing.T) {
+	valid := socketNetworkConfig{
+		Socket: "/tmp/ethernet.sock", Address: "10.0.2.15/24",
+		Gateway: "10.0.2.2", MAC: "02:00:00:00:00:01", MTU: 1500,
+	}
+	for _, tc := range []struct {
+		name   string
+		change func(*socketNetworkConfig)
+	}{
+		{"relative-socket", func(c *socketNetworkConfig) { c.Socket = "relative.sock" }},
+		{"invalid-address", func(c *socketNetworkConfig) { c.Address = "10.0.2.15" }},
+		{"ipv6-address", func(c *socketNetworkConfig) { c.Address = "fd00::1/64" }},
+		{"off-subnet-gateway", func(c *socketNetworkConfig) { c.Gateway = "10.1.2.2" }},
+		{"self-gateway", func(c *socketNetworkConfig) { c.Gateway = "10.0.2.15" }},
+		{"invalid-gateway", func(c *socketNetworkConfig) { c.Gateway = "invalid" }},
+		{"multicast-mac", func(c *socketNetworkConfig) { c.MAC = "01:00:00:00:00:01" }},
+		{"invalid-mac", func(c *socketNetworkConfig) { c.MAC = "invalid" }},
+		{"small-mtu", func(c *socketNetworkConfig) { c.MTU = 575 }},
+		{"large-mtu", func(c *socketNetworkConfig) { c.MTU = 9001 }},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			cfg := valid
+			tc.change(&cfg)
+			data, err := json.Marshal(cfg)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if _, _, err := socketNetworkArgs(strings.NewReader(string(data)), &config.Config{}, false); err == nil {
+				t.Fatal("invalid configuration accepted")
+			}
+		})
+	}
+	data, err := json.Marshal(valid)
+	if err != nil {
+		t.Fatal(err)
+	}
+	args, path, err := socketNetworkArgs(strings.NewReader(string(data)), &config.Config{}, true)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if path != valid.Socket || !args.IsRestore || len(args.FDBasedLinks) != 1 || len(args.LoopbackLinks) != 1 {
+		t.Fatalf("incorrect link configuration: %+v", args)
+	}
+	link := args.FDBasedLinks[0]
+	if link.GSOMaxSize != 0 || link.GVisorGSOEnabled || link.TXChecksumOffload || link.RXChecksumOffload || !link.PreConfigured || link.IsPacket[0] {
+		t.Fatalf("socket link requires complete frames without offload: %+v", link)
+	}
+	if link.Addresses[0].String() != valid.Address || link.Routes[0].Destination.String() != "10.0.2.0/24" || args.Defaultv4Gateway.Route.Gateway.String() != valid.Gateway {
+		t.Fatalf("incorrect addressing and routes: %+v", args)
+	}
+	for _, bad := range []string{string(data) + " {}", strings.Replace(string(data), "\"socket\"", "\"unknown\"", 1)} {
+		if _, _, err := socketNetworkArgs(strings.NewReader(bad), &config.Config{}, false); err == nil {
+			t.Fatal("unexpected JSON accepted")
+		}

#!/bin/bash
set -euo pipefail
plug_args=("$@")
# UML's vector parser rejects '=' inside values. Expand the Slirp URL here.
if [[ ${plug_args[-1]} == slirp:// ]]; then
  plug_args[-1]="slirp:///tcpfwd=127.0.0.1:${LAB_SSH_PORT:-22022}:10.0.2.15:22,127.0.0.1:${LAB_VNC_PORT:-25901}:10.0.2.15:5901"
fi
exec /lab/tools/network/usr/bin/vde_plug "${plug_args[@]}"

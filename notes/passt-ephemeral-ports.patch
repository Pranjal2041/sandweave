 /**
+ * tcp_sock_init_ephemeral() - Bind once, retaining the kernel-assigned port
+ * @c:      Execution context
+ * @addr:   Explicit address to bind
+ * @ifname: Optional interface
+ *
+ * Return: bound port, or a negative error code. The listening fd remains in
+ * epoll for the entire helper lifetime; there is no reservation handoff.
+ */
+int tcp_sock_init_ephemeral(const struct ctx *c,
+                            const union inany_addr *addr, const char *ifname)
+{
+	union sockaddr_inany sa = { 0 };
+	union epoll_ref ref = { .type = EPOLL_TYPE_TCP_LISTEN };
+	socklen_t len = sizeof(sa);
+	union inany_addr bound;
+	in_port_t port;
+	int ret;
+
+	if (!addr || (inany_v4(addr) ? !c->ifi4 : !c->ifi6))
+		return -EAFNOSUPPORT;
+
+	pif_sockaddr(c, &sa, PIF_HOST, addr, 0);
+	ref.fd = sock_l4(c, EPOLL_TYPE_TCP_LISTEN, &sa, ifname);
+	if (ref.fd < 0)
+		return ref.fd;
+	if (getsockname(ref.fd, &sa.sa, &len)) {
+		ret = -errno;
+		goto fail;
+	}
+	ret = inany_from_sockaddr(&bound, &port, &sa);
+	if (ret < 0)
+		goto fail;
+	ref.tcp_listen.port = port;
+	ref.tcp_listen.pif = PIF_HOST;
+	ret = epoll_add(c->epollfd, EPOLLIN, ref);
+	if (ret < 0)
+		goto fail;
+	return port;
+fail:
+	close(ref.fd);
+	return ret;
+}

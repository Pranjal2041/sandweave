 	COMP_TRACE_MARKER();
+	m->lab_begin_ns = os_monotonic_get_ns();
+	if (m->lab_ring != NULL) {
+		/* Advance the cadence, not last-frame + period: the latter rounds a
+		 * 90 Hz request down to 60 Hz on a 120 Hz compositor. Skip missed
+		 * deadlines without generating a burst of stale observations. */
+		if (m->lab_next_ns == 0 || m->lab_begin_ns > m->lab_next_ns + m->lab_period_ns) {
+			m->lab_next_ns = m->lab_begin_ns;
+		}
+		m->lab_next_ns += m->lab_period_ns;
+	}
 
 	VkResult ret;
 
@@ -675,6 +816,8 @@ comp_mirror_do_blit(struct comp_mirror_to_debug_gui *m,
 	struct xrt_frame *frame = &wrap->base_frame;
 	wrap = NULL;
 
+	lab_publish_frame(m, frame, os_monotonic_get_ns());
+	lab_capture_frame(frame);
 	u_sink_debug_push_frame(&m->debug_sink, frame);
 
 	u_frame_times_widget_push_sample(&m->push_frame_times, predicted_display_time_ns);
@@ -689,6 +832,10 @@ comp_mirror_do_blit(struct comp_mirror_to_debug_gui *m,
 void
 comp_mirror_fini(struct comp_mirror_to_debug_gui *m, struct vk_bundle *vk)
 {
+	if (m->lab_ring != NULL) {
+		munmap(m->lab_ring, m->lab_ring_size);
+		m->lab_ring = NULL;
+	}
 	// Remove u_var root as early as possible.
 	u_var_remove_root(m);
 

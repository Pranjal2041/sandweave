@@ -17,6 +17,54 @@
 #include "cache/render_shader_specialization_helpers.h"
 
 #include "render/render_interface.h"
+
+#include "util/u_debug.h"
+#include <stdio.h>
+#include <unistd.h>
+
+/* On-demand evidence capture using the existing GPU readback path. No capture
+ * work is added to ordinary frames unless the request file exists. */
+DEBUG_GET_ONCE_OPTION(lab_eye_capture, "XRT_LAB_EYE_CAPTURE", NULL)
+
+bool
+comp_mirror_lab_capture_requested(void)
+{
+	const char *path = debug_get_option_lab_eye_capture();
+	char request[4096];
+	if (path == NULL || snprintf(request, sizeof(request), "%s.request", path) >= sizeof(request)) {
+		return false;
+	}
+	return access(request, F_OK) == 0;
+}
+
+static void
+lab_capture_frame(struct xrt_frame *frame)
+{
+	if (!comp_mirror_lab_capture_requested()) {
+		return;
+	}
+	const char *path = debug_get_option_lab_eye_capture();
+	char temporary[4096], request[4096];
+	if (snprintf(temporary, sizeof(temporary), "%s.tmp", path) >= sizeof(temporary) ||
+	    snprintf(request, sizeof(request), "%s.request", path) >= sizeof(request)) {
+		return;
+	}
+	FILE *file = fopen(temporary, "wb");
+	if (file == NULL) {
+		return;
+	}
+	bool ok = fprintf(file, "P6\n%u %u\n255\n", frame->width, frame->height) > 0;
+	for (uint32_t y = 0; ok && y < frame->height; y++) {
+		const uint8_t *row = frame->data + y * frame->stride;
+		for (uint32_t x = 0; ok && x < frame->width; x++) {
+			ok = fwrite(row + x * 4, 3, 1, file) == 1;
+		}
+	}
+	ok = fclose(file) == 0 && ok;
+	if (ok && rename(temporary, path) == 0) {
+		unlink(request);
+	}
+}
 
 

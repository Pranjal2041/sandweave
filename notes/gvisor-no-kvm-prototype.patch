+package boot
+
+import (
+	"os"
+	runtimeDebug "runtime/debug"
+	"runtime/metrics"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/log"
+)
+
+// startRuntimeMemoryGuard covers Go allocations, including guest kernel
+// metadata, which are not allocated through pgalloc. This is a sampled guard:
+// it permits transient overshoot and cannot replace a kernel cgroup ceiling.
+// Immutable image cache and allocations outside the Go runtime are excluded.
+func startRuntimeMemoryGuard(limit uint64) func() {
+	if limit == 0 {
+		return func() {}
+	}
+	previous := runtimeDebug.SetMemoryLimit(int64(limit - limit/5))
+	stop, done := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(done)
+		ticker := time.NewTicker(100 * time.Millisecond)
+		defer ticker.Stop()
+		samples := []metrics.Sample{{Name: "/memory/classes/total:bytes"}, {Name: "/memory/classes/heap/released:bytes"}}
+		used := func() uint64 {
+			metrics.Read(samples)
+			return samples[0].Value.Uint64() - samples[1].Value.Uint64()
+		}
+		for {
+			select {
+			case <-stop:
+				return
+			case <-ticker.C:
+				if used() <= limit {
+					continue
+				}
+				runtimeDebug.FreeOSMemory()
+				if current := used(); current > limit {
+					log.Warningf("Runtime memory guard exceeded after reclaim: used=%d limit=%d; terminating sandbox", current, limit)
+					os.Exit(137)
+				}
+			}
+		}
+	}()
+	return func() {
+		close(stop)
+		<-done
+		runtimeDebug.SetMemoryLimit(previous)
+	}
+}

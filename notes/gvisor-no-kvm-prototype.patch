 	refs.DoLeakCheck()
 	os.Exit(code)
 }
+
+// Exercise both directions after serialization in each handler phase, including
+// a reset before establishment (which cannot be distinguished by Result alone).
+func TestCheckpointStateHandlers(t *testing.T) {
+	packet := func(seq, ack uint32, flags header.TCPFlags) header.TCP {
+		tcp := make(header.TCP, header.TCPMinimumSize)
+		tcp.Encode(&header.TCPFields{SeqNum: seq, AckNum: ack, DataOffset: header.TCPMinimumSize, Flags: flags, WindowSize: 30000})
+		return tcp
+	}
+	syn := packet(1234, 0, header.TCPFlagSyn)
+	synAck := packet(789, 1235, header.TCPFlagSyn|header.TCPFlagAck)
+	ack := packet(1235, 790, header.TCPFlagAck)
+	replyAck := packet(790, 1235, header.TCPFlagAck)
+	for _, phase := range []string{"syn", "established", "reset-before-syn-reply"} {
+		t.Run(phase, func(t *testing.T) {
+			original := &tcpconntrack.TCB{}
+			original.Init(syn, 0)
+			if phase == "established" {
+				original.UpdateStateReply(synAck, 0)
+				original.UpdateStateOriginal(ack, 0)
+			} else if phase == "reset-before-syn-reply" {
+				original.UpdateStateReply(packet(789, 1235, header.TCPFlagRst|header.TCPFlagAck), 0)
+			}
+			var saved bytes.Buffer
+			if _, err := state.Save(context.Background(), &saved, &original); err != nil {
+				t.Fatal(err)
+			}
+			var restored *tcpconntrack.TCB
+			if _, err := state.Load(context.Background(), &saved, &restored); err != nil {
+				t.Fatal(err)
+			}
+			first, reply := syn, synAck
+			if phase == "established" {
+				first, reply = ack, replyAck
+			}
+			if got, want := restored.UpdateStateOriginal(first, 0), original.UpdateStateOriginal(first, 0); got != want {
+				t.Fatalf("original direction: got %v want %v", got, want)
+			}
+			if got, want := restored.UpdateStateReply(reply, 0), original.UpdateStateReply(reply, 0); got != want {
+				t.Fatalf("reply direction: got %v want %v", got, want)
+			}
+		})
+	}
+}
